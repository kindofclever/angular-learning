{
  "name": "angular-learning",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "NODE_OPTIONS='--no-deprecation' ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:angular-learning": "node dist/angular-learning/server/server.mjs",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "sanity:typegen": "sanity schema extract && sanity typegen generate"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.13",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.13",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.8",
    "@sanity/client": "^7.12.1",
    "@sanity/image-url": "^1.2.0",
    "express": "^5.1.0",
    "react-is": "^19.2.0",
    "rxjs": "~7.8.0",
    "styled-components": "^6.1.19",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.8",
    "@angular/cli": "^20.3.8",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/localize": "^20.3.12",
    "@sanity/codegen": "^4.15.0",
    "@sanity/types": "^4.15.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "autoprefixer": "^10.4.22",
    "dotenv": "^17.2.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanity": "^4.15.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2"
  }
}
